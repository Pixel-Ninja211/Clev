{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clev",
  "version": "1.0.0",
  "identifier": "app.clev.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Clev",
        "width": 420,
        "height": 520,
        "x": 120,
        "y": 120,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Clev — your jolly desktop companion"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Utility",
    "shortDescription": "Jolly AI desktop companion widget",
    "longDescription": "Clev is a cheerful, witty floating AI companion that lives on your desktop: chat, code help, vibe-checking music, real hardware telemetry and playful easter eggs.",
    "copyright": "© 2026 Clev",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  },
  "plugins": {}
}
