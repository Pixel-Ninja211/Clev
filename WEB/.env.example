# CLEV AI HUD — environment template
# Copy to .env for local dev:  cp .env.example .env
# For production, add these as GitHub repository Secrets (Settings → Secrets and variables → Actions).

# Gemini API key (https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys)
# If missing/invalid, CLEV automatically falls back to the browser's built-in voice.
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
